{
  "name": "tossinvest-cli-docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "node scripts/sync-changelog.mjs && next build",
    "dev": "node scripts/sync-changelog.mjs && next dev",
    "start": "next start",
    "check:docs": "node scripts/check-docs.mjs",
    "types:check": "node scripts/sync-changelog.mjs && fumadocs-mdx && next build",
    "sync:changelog": "node scripts/sync-changelog.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.15.7",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.7",
    "lucide-react": "^1.41.0",
    "mermaid": "11.17.2",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2"
  },
  "pnpm": {
