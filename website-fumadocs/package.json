{
  "name": "tossinvest-cli-docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "node scripts/sync-changelog.mjs && next build",
    "dev": "node scripts/sync-changelog.mjs && next dev",
    "start": "next start",
    "check:docs": "node scripts/check-docs.mjs",
    "types:check": "node scripts/sync-changelog.mjs && fumadocs-mdx && next build",
    "sync:changelog": "node scripts/sync-changelog.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.58.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "source-map-js": ">=1.2.2",
      "compression": ">=1.8.2",
      "sharp": ">=0.35.5",
      "fast-uri@3": "3.1.8",
      "katex": ">=0.18.2"
    }
