#!/bin/bash
# 데모용 스텁 — 실제 tossctl 아님. 합성 출력만.
case "$1 $2" in
  "auth login")
    printf '  토스 앱으로 QR 스캔 후 승인하세요\n'
    sleep 0.6
    printf '  \033[38;5;114m✔\033[0m 세션 활성 · 7일간 유효\n' ;;
  "quote get")
    printf '  \033[1m%s\033[0m  NVIDIA Corp\n' "$3"
    printf '  현재가 \033[38;5;203m304,050\033[0m KRW   +0.92%%   거래량 8.7M\n' ;;
  "market briefing")
    printf '  \033[38;5;114m반도체\033[0m  메모리 반등 기대에 관련주 강세\n'
    printf '  \033[38;5;114mAI\033[0m      엔비디아 실적 앞두고 관망세\n'
    printf '  \033[38;5;114m환율\033[0m    달러 강세 지속 · 1,483원선\n' ;;
  *) printf '  (demo)\n' ;;
esac
